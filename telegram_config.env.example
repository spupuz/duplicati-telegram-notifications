# Telegram Configuration Template for Duplicati Notifications
# Copy this file to 'telegram_config.env' and populate with your own values.

TELEGRAM_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHATID="YOUR_TELEGRAM_CHAT_ID"

# Auto-update: set to "false" to disable the automatic update check on GitHub.
# Default (if omitted): "true"
AUTO_UPDATE="true"
